{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Labor Tracker",
  "version": "0.1.0",
  "identifier": "com.labortracker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Labor Tracker",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {}
  },
  "plugins": {
    "sql": {
      "preloaded": ["sqlite:labor.db"]
    }
  }
}
