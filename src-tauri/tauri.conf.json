{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Labor Tracker",
  "version": "0.1.0",
  "identifier": "com.labortracker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Labor Tracker",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "sql": {
      "preloaded": ["sqlite:labor.db"]
    }
  }
}
